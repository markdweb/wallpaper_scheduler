<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core wallpaper-change capability -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Re-arm the schedule after the device reboots -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Exact-time firing. On API 31-32 this is granted automatically. On API 33+ the user
        must approve it once (we deep-link to the system settings screen for this); the app
        still works with inexact timing if declined, it just won't be to-the-minute.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Optional "wallpaper changed" notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WallpaperSchedulerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WallpaperScheduler">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WallpaperScheduler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fired by AlarmManager at the scheduled light/dark times -->
        <receiver
            android:name=".scheduler.WallpaperAlarmReceiver"
            android:exported="false" />

        <!-- Re-registers the alarms after a reboot, since AlarmManager alarms do not survive one -->
        <receiver
            android:name=".scheduler.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
